# 复制成 .env.development / .env.production 后按需修改。
# 所有变量必须以 VITE_ 开头，否则不会被注入到前端代码里。

# 后端 API 基地址。
#   /api            —— 与前端同源，由 OpenResty 把 /api 反代到后端。生产环境推荐，
#                      浏览器不产生跨域请求，也就不依赖后端 CORS 白名单。
#   https://xxx/api —— 后端在另一个域名时才用绝对地址，此时必须把该前端域名
#                      加进后端 app.cors.allowed-origins。
VITE_API_BASE_URL=/api

# 仅本地开发使用：vite dev server 把 /api 转发到哪个地址。
# 生产构建完全不用这一项。
VITE_DEV_PROXY_TARGET=http://localhost:8080
